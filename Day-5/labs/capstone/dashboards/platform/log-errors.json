  "panels": [
    {
      "type": "timeseries",
      "title": "Target up/down",
      "id": 1,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prom-main" },
      "targets": [
        { "expr": "up", "legendFormat": "{{job}} {{instance}}", "refId": "A" }
      ]
    }
  ]
}
