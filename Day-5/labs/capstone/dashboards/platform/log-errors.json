{
  "uid": "log-errors",
  "title": "Platform · Error Signals",
  "tags": ["capstone", "logs"],
  "schemaVersion": 39,
  "version": 1,
  "id": null,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
